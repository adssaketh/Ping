<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- `dev` is read-only (master prompt A1b): it must not be able to send, receive as default app, or change the
         user's real messages. Components (receivers, HeadlessSmsSendService, default-SMS intent filters) are added to
         the main manifest in Phase 4 and removed here with tools:node="remove" at the same time. -->
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" tools:node="remove" />
</manifest>
